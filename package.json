{
  "name": "fastify-prisma-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Basic CRUD application with Fastify, Prisma, PostgreSQL and TypeScript",
  "keywords": [
    "crud",
    "fastify",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "author": "Marcelo Knob",
  "license": "MIT",
  "type": "module",
  "module": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prisma:mm": "prisma migrate dev",
    "prisma:md": "prisma migrate dev --name diff --create-only",
    "prisma:mr": "prisma migrate reset",
    "prisma:p": "prisma db pull",
    "prisma:v": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^7.0.0",
    "@fastify/jwt": "^10.1.0",
    "@prisma/client": "5.22.0",
    "fastify": "^5.9.0",
    "fastify-favicon": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/node": "^24.13.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "prisma": "^5.22.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  }
}
